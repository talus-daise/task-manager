{
  "manifest_version": 3,
  "name": "今日やる - タスク管理",
  "short_name": "今日やる",
  "version": "0.2.0",
  "description": "忘れっぽく先延ばしがちな人のための、締切優先のタスク管理。新しいタブを置き換えます。",
  "browser_specific_settings": {
    "gecko": {
      "id": "task-manager@example.com",
      "strict_min_version": "115.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
